# Copy to `.env` for local development. In staging/production set these in the host's
# environment (Render dashboard). Never commit real values.

ENV=local                      # local | test | staging | production
CORS_ORIGINS=*                 # comma-separated origins; must be explicit in production

# --- Database (PostgreSQL with PostGIS) ---
DATABASE_URL=postgresql://autoscope:autoscope@127.0.0.1:5432/autoscope_dev
REDIS_URL=                     # optional locally; required for multi-instance rate limits

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-staging-and-production

# --- Integrations: leave "mock" until you have real keys (see docs/INTEGRATIONS.md) ---
SMS_DRIVER=mock                # mock | termii
EMAIL_DRIVER=mock              # mock | smtp
PUSH_DRIVER=mock               # mock | fcm
PAYMENT_DRIVER=mock            # mock | paystack
KYC_DRIVER=mock
STORAGE_DRIVER=local           # local | s3
VIN_DRIVER=mock                # mock | nhtsa
SOCIAL_DRIVER=mock             # mock | live (Google/Apple sign-in; mock accepts "mock:<id>:<email>:<name>")
GOOGLE_CLIENT_IDS=             # comma-separated: iOS, Android and web OAuth client ids
APPLE_CLIENT_IDS=              # iOS bundle id (and Services id if web sign-in is added)

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TERMII_API_KEY=
TERMII_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AutoScope <no-reply@autoscope.ng>
FCM_SERVICE_ACCOUNT_JSON=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
