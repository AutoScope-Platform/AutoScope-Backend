# Copy to `.env` for local development. In staging/production these come from the host:
# Azure Container Apps with Key Vault (docs/AZURE.md), or the Render dashboard. Never commit
# real values.

ENV=local                      # local | test | staging | production
CORS_ORIGINS=*                 # comma-separated origins; must be explicit in production

# --- Database (PostgreSQL with PostGIS) ---
DATABASE_URL=postgresql://autoscope:autoscope@127.0.0.1:5432/autoscope_dev
DB_POOL_SIZE=10                # per process; small Azure tiers allow ~50 connections in total
DB_MAX_OVERFLOW=20
REDIS_URL=                     # optional locally; required with TASK_QUEUE=celery or 2+ instances
                               # Azure: rediss://:<key>@<name>.redis.cache.windows.net:6380/0
TASK_QUEUE=inline              # inline | celery (push/SMS/e-mail sent by the worker)
RUN_MIGRATIONS=                # "true": the container migrates on start (Render); Azure uses a job

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-staging-and-production

# --- Integrations: leave "mock" until you have real keys (see docs/INTEGRATIONS.md) ---
SMS_DRIVER=mock                # mock | termii
EMAIL_DRIVER=mock              # mock | smtp
PUSH_DRIVER=mock               # mock | fcm
PAYMENT_DRIVER=mock            # mock | paystack
KYC_DRIVER=mock
STORAGE_DRIVER=local           # local | s3 | azure
VIN_DRIVER=mock                # mock | nhtsa
SOCIAL_DRIVER=mock             # mock | live (Google/Apple sign-in; mock accepts "mock:<id>:<email>:<name>")
GOOGLE_CLIENT_IDS=             # comma-separated: iOS, Android and web OAuth client ids
APPLE_CLIENT_IDS=              # iOS bundle id (and Services id if web sign-in is added)

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TERMII_API_KEY=
TERMII_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AutoScope <no-reply@autoscope.ng>
FCM_SERVICE_ACCOUNT_JSON=
S3_ENDPOINT_URL=               # Neon: the branch's storage endpoint (docs/INTEGRATIONS.md)
S3_REGION=auto                 # Neon Frankfurt: eu-central-1; R2: auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=   # with AccountKey (signs the download links)
AZURE_STORAGE_CONTAINER=uploads
APPLICATIONINSIGHTS_CONNECTION_STRING=   # Azure Monitor: requests, errors, logs
